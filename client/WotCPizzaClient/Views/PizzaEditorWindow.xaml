<Window x:Class="WotCPizzaClient.Views.PizzaEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:WotCPizzaClient.Resources"
        Title="{Binding ButtonLabel}" Width="540" Height="750" MinWidth="430" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="{Binding ButtonLabel}" FontSize="26" FontWeight="Bold" Margin="0,0,0,14" />
            <TextBlock Text="{r:Loc Size}" Style="{StaticResource Heading}" />
            <ComboBox ItemsSource="{Binding Sizes}" SelectedItem="{Binding SelectedSize}" DisplayMemberPath="Label" AutomationProperties.Name="{r:Loc Size}" />
            <TextBlock Text="{r:Loc Category}" Style="{StaticResource Heading}" />
            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Label" AutomationProperties.Name="{r:Loc Category}" />
            <Border Background="White" CornerRadius="6" Padding="12" BorderBrush="#E4D8CF" BorderThickness="1">
                <ScrollViewer Height="185" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SelectedCategory.Toppings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding Selected}" Margin="4,7" /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <TextBlock Text="{r:Loc Quantity}" Style="{StaticResource Heading}" />
            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" MaxLength="3" AutomationProperties.Name="{r:Loc Quantity}" />
            <TextBlock Text="{Binding Error}" Foreground="#A12819" TextWrapping="Wrap" />
            <DockPanel Margin="0,10"><TextBlock Text="{Binding UnitPrice}" DockPanel.Dock="Right" /><TextBlock Text="{r:Loc UnitPrice}" /></DockPanel>
            <DockPanel Margin="0,10"><TextBlock Text="{Binding Total}" DockPanel.Dock="Right" FontWeight="Bold" /><TextBlock Text="{r:Loc LinePrice}" FontWeight="Bold" /></DockPanel>
            <Button Content="{Binding ButtonLabel}" IsEnabled="{Binding CanSave}" Click="Save_Click" IsDefault="True" Style="{StaticResource AccentButton}" />
        </StackPanel>
    </ScrollViewer>
</Window>
